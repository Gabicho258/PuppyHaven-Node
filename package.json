{
  "name": "puppy-haven-node",
  "version": "1.0.0",
  "main": "server.ts",
  "scripts": {
    "build": "tsc",
    "start:prod": "node dist/server.js",
    "db:deploy": "npx prisma migrate deploy && npx prisma generate",
    "dev": "nodemon --exec tsx server.ts",
    "prisma:deploy:render": "npx prisma migrate deploy && prisma generate && npm run seed-regions && npm run seed-database",
    "build:prod:render": "npm install && tsc && npm run prisma:deploy:render"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "nodemon": "^3.1.10"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.21",
    "prisma": "^6.10.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gabicho258/PuppyHaven-Node.git"
  },
  "bugs": {
    "url": "https://github.com/Gabicho258/PuppyHaven-Node/issues"
  },
  "homepage": "https://github.com/Gabicho258/PuppyHaven-Node#readme"
